% Commands used for printing URLs in the bib files %
% e.g. \biburl{http://www.unifr.ch/}{11}{January}{2004}
\newcommand{\lastVisited}[3]{(Letzter Aufruf #2 #1, #3)} % e.g. \lastVisited{11}{January}{2004}
\newcommand{\biburl}[4]{{\url{#1} \lastVisited{#2}{#3}{#4}}}

% e.g. \biburlarticle{http://www.unifr.ch/article.html}{14}{January}{2004}
\newcommand{\biburlarticle}[4]{[Erhalten am #3 #2, #4, von {\small\url{#1}}]}

