                    <representation xmlns:ns2="http://eHealth" element="ns2:patient"
                        mediaType="application/xml"/>
                    <representation xmlns:ns2="http://eHealth" element="ns2:patient"
                        mediaType="application/json"/>
                    <representation xmlns:ns2="http://eHealth" element="ns2:patient"
                        mediaType="text/xml"/>
                </response>
            </method>
            <method id="delPatient" name="DELETE">
                <response>
                    <representation mediaType="text/plain"/>
                </response>
            </method>
            <method id="delPatientXML" name="DELETE">
                <response>
                    <representation xmlns:ns2="http://eHealth" element="ns2:patient"
                        mediaType="application/xml"/>
                    <representation xmlns:ns2="http://eHealth" element="ns2:patient"
                        mediaType="application/json"/>
                    <representation xmlns:ns2="http://eHealth" element="ns2:patient"
                        mediaType="text/xml"/>
                </response>
            </method>
        </resource>
        <resource path="/patients/{pid}/medicalrecord/consultations">
            <param xmlns:xs="http://www.w3.org/2001/XMLSchema" name="pid" style="template"
                type="xs:int"/>
            <method id="getListOfConsultationXML" name="GET">
                <response>
                    <representation xmlns:ns2="http://eHealth" element="ns2:medicalRecord"
                        mediaType="application/xml"/>
                    <representation xmlns:ns2="http://eHealth" element="ns2:medicalRecord"
                        mediaType="application/json"/>
                    <representation xmlns:ns2="http://eHealth" element="ns2:medicalRecord"
                        mediaType="text/xml"/>
                </response>
            </method>
            <method id="getListOfConsultationHTML" name="GET">
                <response>
                    <representation mediaType="text/html"/>
                </response>
            </method>
            <method id="addConsultationXML" name="POST">
                <request>
                    <representation xmlns:ns2="http://eHealth" element="ns2:consultation"
                        mediaType="application/xml"/>
                    <representation xmlns:ns2="http://eHealth" element="ns2:consultation"
                        mediaType="application/json"/>
                    <representation xmlns:ns2="http://eHealth" element="ns2:consultation"
                        mediaType="text/xml"/>
                </request>
                <response>
                    <representation xmlns:ns2="http://eHealth" element="ns2:consultation"
                        mediaType="application/xml"/>
                    <representation xmlns:ns2="http://eHealth" element="ns2:consultation"
                        mediaType="application/json"/>
                    <representation xmlns:ns2="http://eHealth" element="ns2:consultation"
                        mediaType="text/xml"/>
                </response>
            </method>
        </resource>
    </resources>
</application>
